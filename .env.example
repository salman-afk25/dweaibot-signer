# SALIN file ini jadi .env, lalu isi nilainya sendiri. JANGAN commit .env.
# JANGAN kirim file .env / nilai di bawah ini ke chat, repo, atau screenshot.

# Rahasia API signer - buat acak yang panjang, dipakai bot -> signer
SIGNER_API_SECRET=isi-dengan-secret-acak-panjang-di-sini
# Password enkripsi keystore.json - simpan terpisah dari keystore.json
KEYSTORE_PASSWORD=isi-dengan-password-keystore-di-sini

# Limit signer (native, BUKAN USD - 0.01 ETH beda nilainya dengan 0.01 BNB)
MAX_TX_NATIVE=0.01
DAILY_LIMIT_NATIVE=0.02
SIGNER_PORT=8000

# RPC per chain - isi hanya chain yang mau dipakai, kosongkan sisanya
ETH_RPC=
BSC_RPC=
BASE_RPC=
POLYGON_RPC=
ARBITRUM_RPC=

# Telegram - dari BotFather, dan ID numerik Telegram kamu (bukan username)
TELEGRAM_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
SIGNER_API_URL=http://127.0.0.1:8000
